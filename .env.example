# ===== 数据库（Supabase PostgreSQL）=====
# 连接串请从 Supabase 控制台 → Project Settings → Database → Connection string 获取。
# 服务端（packages/api）使用；不要加 NEXT_PUBLIC_ 前缀，避免泄漏到浏览器。
DATABASE_URL=
# 本地/内网自建 Postgres 且不支持 SSL 时设为 false
DATABASE_SSL=true

# ===== 各端端口（dev 与 start 脚本都读这里，缺省回落到 3001 / 8787 / 3000 / 8081）=====
# 管理后台（apps/admin）
PORT_ADMIN=19866
# 接口服务（packages/api）
PORT_API=19852
# 用户端（apps/web）
PORT_WEB=20132
# 移动端 Metro（apps/mobile）
PORT_MOBILE=20196

# ===== 管理员登录 =====
# 用于签发/校验管理员登录凭证（HS256），请使用随机长字符串
ADMIN_JWT_SECRET=
# CORS 允许的 admin 来源，多个用逗号分隔；端口变了这里要同步改
CORS_ORIGINS=http://localhost:19866

# ===== 图片存储（Supabase Storage，店铺/商品图片上传）=====
# 只在上传接口使用，服务端凭证绝不下发到前端；未配置时上传返回 503。
# 可留空：留空时按 DATABASE_URL 推导 https://<project-ref>.supabase.co
SUPABASE_URL=
# 必填（无法从 DATABASE_URL 推导），Supabase 控制台 → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=
# 桶名默认读 DATABASE_BUCKET（根 .env 已有 sdsbucket），无需重复填写。
# 只有「存储桶名 != DATABASE_BUCKET」时才填这里；两者都填时以 DATABASE_BUCKET 为准，避免互相矛盾。
SUPABASE_STORAGE_BUCKET=

# ===== admin 应用（apps/admin）=====
# Next 服务端转发登录请求到 API 的地址；留空则按 PORT_API 自动派生
API_BASE_URL=

# ===== web 缓存失效（可选）=====
# 后台改店后通知 web 端 revalidateTag('shops')。
# 两端填同一个随机串；不填时 admin 跳过通知，web 最迟 60 秒自然过期。
# admin 侧填 web 站点地址（如 https://sds.whoitao.top），web 侧只填密钥。
WEB_REVALIDATE_URL=
REVALIDATE_SECRET=

# ===== 高德地图（admin / web 共用，packages/ui 的选点组件）=====
# 浏览器端可见：SDS_PUBLIC_ 前缀的值会在构建时内联进前端产物（由各 app 的 next.config `env` 显式映射），
# 请在高德控制台配置域名白名单。未填写时地图组件降级为提示，不影响后台手动填写经纬度。
SDS_PUBLIC_AMAP_KEY=
# 2021-12 之后申请的 Key 需要配套「安全密钥」，二选一：
# 1) 安全密钥（推荐，与上面的 Key 一起使用）
SDS_PUBLIC_AMAP_SECURITY_CODE=
# 2) 或改用代理服务器方案，此时把代理地址填到 SDS_PUBLIC_AMAP_SERVICE_HOST
SDS_PUBLIC_AMAP_SERVICE_HOST=
