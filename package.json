{
  "name": "sds",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @sds/api dev",
    "dev:web": "pnpm --filter @sds/web dev",
    "dev:admin": "pnpm --filter @sds/admin dev",
    "dev:mobile": "pnpm --filter @sds/mobile dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "db:generate": "turbo run db:generate",
    "seed:test": "node scripts/seed-test-data.mjs"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "~5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@swc/core",
      "unrs-resolver"
    ]
  }
}
