{
  "expo": {
    "name": "捎点啥",
    "slug": "sds-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "newArchEnabled": true,
    "platforms": ["ios", "android"],
    "icon": "./assets/icon.png",
    "plugins": [
      ["expo-location", { "locationWhenInUsePermission": "用于查找离您最近的门店；不授权也可以按店名、街道或小区找店。" }]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sds.mobile"
    },
    "android": {
      "package": "com.sds.mobile"
    }
  }
}
