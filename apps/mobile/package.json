{
  "name": "@sds/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "node ../../scripts/run-app.mjs mobile dev",
    "start": "node ../../scripts/run-app.mjs mobile start",
    "android": "node ../../scripts/run-app.mjs mobile dev --android",
    "build:androidLocal": "node ../../scripts/run-app.mjs mobile build --platform android --local --profile preview",
    "ios": "node ../../scripts/run-app.mjs mobile dev --ios",
    "build:iosLocal": "node ../../scripts/run-app.mjs mobile build --platform ios --local --profile preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sds/shared": "workspace:*",
    "expo": "~58.0.26",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.21",
    "expo-gaode-map": "2.3.2",
    "expo-location": "~58.0.22",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eas-cli": "^27.10.0",
    "typescript": "~6.0.3"
  }
}
