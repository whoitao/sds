# admin 端服务端配置（复制为 apps/admin/.env.local 使用）
# 可选：Next 服务端转发登录/查询请求到 Hono API 的地址。
# 留空或不建此文件时，按根 .env 的 PORT_API 自动派生 http://localhost:<PORT_API>。
# API_BASE_URL=http://localhost:19852

# 高德地图选点（浏览器端可见，注意域名白名单）。
# 根目录 .env 里的同名变量即可生效；此处仅说明变量含义。
# SDS_PUBLIC_AMAP_KEY=
# SDS_PUBLIC_AMAP_SECURITY_CODE=
# SDS_PUBLIC_AMAP_SERVICE_HOST=
