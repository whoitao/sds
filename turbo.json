{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"],
      "env": [
        "API_BASE_URL",
        "SDS_PUBLIC_AMAP_KEY",
        "SDS_PUBLIC_AMAP_SECURITY_CODE",
        "SDS_PUBLIC_AMAP_SERVICE_HOST"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "db:generate": {
      "cache": false
    }
  }
}
